# myhandball.lab241.com 앞단 프록시 (HTTPS 자동 발급·갱신)
#
# Caddy가 Let's Encrypt 인증서를 알아서 받고 만료 전에 갱신한다. 무료.
# - email은 인증서 만료 안내용이고, Let's Encrypt가 실패하면 ZeroSSL로 자동 전환할 때도 쓴다
# - DNS에서 이 도메인이 서버(집 공인 IP)를 가리켜야 하고,
#   공유기에서 443(가능하면 80도)을 이 서버로 포워딩해야 발급된다. 80이 막혀도 443만으로 발급된다
#
# 도커(deploy/docker-compose.yml)에서 쓴다. 값은 deploy/.env에서 온다

{
	email {$ACME_EMAIL}
}

{$DOMAIN:myhandball.lab241.com} {
	encode zstd gzip

	# API만 NestJS로 넘긴다. 앱은 https://myhandball.lab241.com/api/... 로 부른다
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# 나머지 경로는 아직 쓰는 곳이 없다 (v1 웹을 여기 다시 올리면 이 자리에 추가)
	handle {
		respond "myhandball api" 404
	}
}
