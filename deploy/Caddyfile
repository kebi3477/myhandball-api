# myhandball.kro.kr 앞단 프록시 (HTTPS 자동 발급·갱신)
#
# Caddy가 Let's Encrypt(실패 시 ZeroSSL) 인증서를 알아서 받고 만료 전에 갱신한다.
# 공유기에서 443(가능하면 80도)을 이 Mac으로 포워딩해야 발급된다.
# 80이 막혀 있어도 443만으로 발급된다 (TLS-ALPN 방식).
#
# 적용: /opt/homebrew/etc/Caddyfile 이 이 파일을 import 하고, `brew services start caddy`로 띄운다.
# 설정을 바꾼 뒤: `caddy validate --config deploy/Caddyfile` → `brew services restart caddy`

myhandball.kro.kr {
	encode zstd gzip

	# API만 NestJS(localhost:3000)로 넘긴다. 앱은 https://myhandball.kro.kr/api/... 로 부른다
	handle /api/* {
		reverse_proxy localhost:3000
	}

	# 나머지 경로는 아직 쓰는 곳이 없다 (v1 웹을 여기 다시 올리면 이 자리에 추가)
	handle {
		respond "myhandball api" 404
	}

	log {
		output file /opt/homebrew/var/log/caddy/myhandball.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
