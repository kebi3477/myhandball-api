# myhandball.lab241.com 앞단 프록시 (HTTPS 자동 발급·갱신)
#
# Caddy가 Let's Encrypt 인증서를 알아서 받고 만료 전에 갱신한다. 무료.
# - email은 인증서 만료 안내용이고, Let's Encrypt가 실패하면 ZeroSSL로 자동 전환할 때도 쓴다
# - DNS에서 이 도메인이 서버(집 공인 IP)를 가리켜야 하고,
#   공유기에서 443(가능하면 80도)을 이 서버로 포워딩해야 발급된다. 80이 막혀도 443만으로 발급된다
#
# 도커(deploy/docker-compose.yml)에서 쓴다. 값은 deploy/.env에서 온다
{
	email {$ACME_EMAIL}
}

# 도메인 입구와 집 안 입구가 같이 쓰는 라우팅
(myhandball_routes) {
	encode zstd gzip

	# API만 NestJS로 넘긴다. 앱은 https://myhandball.lab241.com/api/... 로 부른다
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# 앱 설정 화면이 여는 정책 페이지 (앱의 AppConfig.privacyUrl / termsUrl)
	@privacy path /privacy /privacy/
	handle @privacy {
		rewrite * /api/policy/privacy/page
		reverse_proxy {$API_UPSTREAM:api:3000}
	}
	@terms path /terms /terms/
	handle @terms {
		rewrite * /api/policy/terms/page
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# 나머지 경로는 아직 쓰는 곳이 없다 (v1 웹을 여기 다시 올리면 이 자리에 추가)
	handle {
		respond "myhandball api" 404
	}
}

# 외부 입구 (HTTPS)
{$DOMAIN:myhandball.lab241.com} {
	import myhandball_routes
}

# 집 안 입구 (HTTP, 인증서 없음): http://<미니 PC 내부 IP>:8080/api/...
# 공유기는 집 안에서 공인 IP(도메인)로 되돌아오는 접속을 지원하지 않아서, 같은 공유기 안의
# 기기(작업 PC, 테스트 폰)는 도메인으로 서버에 닿지 않는다. 그때 쓰는 입구다.
# 공유기에서 8080을 포워딩하지 않으므로 외부에는 열리지 않는다
http://:{$LAN_HTTP_PORT:8080} {
	import myhandball_routes
}

# tapeletter (구 cassette. github.com/kebi3477/cassette-api, 미니PC ~/projects/cassette-api)
# 같은 443을 나눠 쓴다. 인증서는 여기서 발급·갱신하고, 입구 컨테이너(cassette-edge)로 넘긴다.
# cassette-edge는 docker-compose.edge.yml로 이 네트워크(myhandball_default)에 들어온다.
# 내려가 있으면 이 도메인들만 502가 나고 myhandball에는 영향이 없다.
# cassette.lab241.com은 이름 변경 전환 기간 동안만 같이 연다 (옛 앱·옛 링크가 사라지면 뺀다).
tapeletter.lab241.com, cassette.lab241.com {
	reverse_proxy cassette-edge:80
}
