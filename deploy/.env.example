# deploy/docker-compose.yml 이 읽는 값. 복사해서 deploy/.env 로 쓴다 (git에 올리지 않음)

# DB 비밀번호 (아무 긴 난수). 한 번 정하면 바꾸지 않는다 (볼륨에 이 값으로 초기화됨)
POSTGRES_PASSWORD=

# 응원글 작성자 ID를 만드는 비밀값 (아무 긴 난수, openssl rand -hex 32).
# **처음 정한 뒤 바꾸지 않는다** — 바꾸면 모든 작성자 ID와 차단 목록이 어긋난다
AUTHOR_ID_SECRET=

# 인증서 계정 이메일 (만료 안내, Let's Encrypt가 실패하면 ZeroSSL로 전환할 때 사용)
ACME_EMAIL=

DOMAIN=myhandball.lab241.com

# 현재 시즌 고정 (2025 = 25-26 시즌). 새 시즌 일정이 나오면 비우거나 바꾼다
CURRENT_SEASON=2025

LIVE_POLLING=true

# 집 안(같은 공유기) 전용 HTTP 입구 포트. 공유기에서 포워딩하지 않는다
LAN_HTTP_PORT=8080

# v1 웹을 다시 올리면 그 도메인 (쉼표 구분)
CORS_ORIGINS=

# FCM 푸시. 비우면 드라이런 (발송 대신 로그)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
