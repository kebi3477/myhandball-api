# deploy/docker-compose.yml 이 읽는 값. 복사해서 deploy/.env 로 쓴다 (git에 올리지 않음)

# DB 비밀번호 (아무 긴 난수). 한 번 정하면 바꾸지 않는다 (볼륨에 이 값으로 초기화됨)
POSTGRES_PASSWORD=

# 응원글 작성자 ID를 만드는 비밀값 (아무 긴 난수, openssl rand -hex 32).
# **처음 정한 뒤 바꾸지 않는다** — 바꾸면 모든 작성자 ID와 차단 목록이 어긋난다
AUTHOR_ID_SECRET=

# 관리자 페이지 토큰 (https://myhandball.lab241.com/api/admin). 긴 난수 (openssl rand -hex 32).
# 비우면 관리자 기능이 꺼진다. 모든 테이블을 수정할 수 있으니 절대 공유하지 않는다
ADMIN_TOKEN=

# DB 백업 보관 개수 (매일 04:00 KST, deploy/backups/ 에 저장)
BACKUP_KEEP=14

# 인증서 계정 이메일 (만료 안내, Let's Encrypt가 실패하면 ZeroSSL로 전환할 때 사용)
ACME_EMAIL=

DOMAIN=myhandball.lab241.com

# 현재 시즌 고정 (2025 = 25-26 시즌). 새 시즌 일정이 나오면 비우거나 바꾼다
CURRENT_SEASON=2025

# 다음 시즌 개막일 — 연맹 공지로 확인한 값만 넣는다 (추정 금지). 형식 "<시즌 시작 연도>=<ISO 8601>"
# 일정이 올라오면 일정의 첫 경기가 우선이라 그대로 둬도 된다. 모르면 비워 둔다 (앱은 "11월"처럼 달만 보여 줌)
SEASON_OPENS_AT_M=
SEASON_OPENS_AT_W=

LIVE_POLLING=true

# 집 안(같은 공유기) 전용 HTTP 입구 포트. 공유기에서 포워딩하지 않는다
LAN_HTTP_PORT=8080

# v1 웹을 다시 올리면 그 도메인 (쉼표 구분)
CORS_ORIGINS=

# 앱 업데이트 안내 (GET /api/app/version). 스토어에 새 버전이 올라가면 LATEST_VERSION을 올린다.
# 비우면 그 플랫폼은 404 → 앱이 안내를 띄우지 않는다. MIN_VERSION(강제 업데이트)은 되도록 비워 둔다
APP_ANDROID_LATEST_VERSION=
APP_ANDROID_MIN_VERSION=
APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.myhandball.app
APP_ANDROID_NOTES=
APP_IOS_LATEST_VERSION=
APP_IOS_MIN_VERSION=
# 예: https://apps.apple.com/kr/app/id<앱ID>
APP_IOS_STORE_URL=
APP_IOS_NOTES=

# FCM 푸시. 비우면 드라이런 (발송 대신 로그)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
