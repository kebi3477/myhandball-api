# ENV
BASE=https://www.koreahandball.com
PORT=3000

# [REDIS]
REDIS_URL=redis://127.0.0.1:6379/0

# [DATABASE]
DATABASE_URL=
DATABASE_SSL=false

# [LIVE]
# 경기 중 PBP 폴링 (기본 켜짐). 로컬에서 끄려면 false
LIVE_POLLING=true

# [PUSH] FCM 서비스 계정. 비어 있으면 발송 대신 로그만 남긴다 (드라이런)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# 개행은 \n 으로 적는다
FCM_PRIVATE_KEY=

# [ENGAGEMENT] 응원글 작성자 ID(HMAC) 비밀값. 비우면 개발용 기본값 (운영에서는 반드시 설정, 바꾸지 않음)
AUTHOR_ID_SECRET=

# [ADMIN] 관리자 페이지 토큰 (/api/admin). 24자 이상. 비우면 관리자 기능 꺼짐
ADMIN_TOKEN=
# 백업 위치 (기본 ./backups)
BACKUP_DIR=

# [SEASON] 현재 시즌 고정 (시작 연도, 2025 = 25-26 시즌). 비우면 날짜로 계산 (KST 8월부터 새 시즌)
CURRENT_SEASON=2025
